{
  "name": "omnigeo",
  "private": true,
  "version": "1.0.0",
  "description": "OmniGeo desktop geospatial data processing workbench.",
  "author": "OmniGeo by Maodo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "generate:crs": "node scripts/generate-crs-catalog.mjs",
    "prebuild": "npm run generate:crs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "license:init-keys": "node scripts/license-cli.mjs init-keys",
    "license:issue": "node scripts/license-cli.mjs issue",
    "license:verify": "node scripts/license-cli.mjs verify",
    "electron:start": "npm run generate:crs && npx vite build --base=./ && npx electron .",
    "dist:win": "npm run generate:crs && npx vite build --base=./ && npx electron-builder --win",
    "dist:mac": "npm run generate:crs && npx vite build --base=./ && npx electron-builder --mac"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "papaparse": "^5.7.0",
    "proj4": "^2.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "shpjs": "^6.2.0",
    "sql.js": "^1.15.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shpjs": "^3.4.7",
    "@types/sql.js": "^1.4.11",
    "epsg-index": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.omnigeo.desktop",
    "productName": "OmniGeo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!.license-secrets",
      "!scripts",
      "!*.omnigeo-lic"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
